{
  "base_url": "http://localhost:8149",
  "viewport": {
    "width": 1440,
    "height": 900
  },
  "device_scale_factor": 2,
  "ready": {
    "expr": "window.__FRAME_READY === true",
    "timeout_ms": 60000,
    "note": "set in app.js armNext() after the first painted frame"
  },
  "settle_ms": 600,
  "thresholds": {
    "changed_frac": 0.0005,
    "mean_abs": 0.15
  },
  "blank_variance_floor": 4.0,
  "frames": [
    {
      "name": "globe-default",
      "path": "/?frozen=1",
      "note": "the frame the \u00a713 check is run on \u2014 Ocean Crossing era, 1590"
    },
    {
      "name": "globe-crossing",
      "path": "/?frozen=1#e=0&t=40000",
      "note": "era 0 \u2014 the first crossings, low sea level and exposed shelves"
    },
    {
      "name": "globe-steam",
      "path": "/?frozen=1#e=5&t=1870",
      "note": "era 5 \u2014 iron and steam"
    },
    {
      "name": "globe-modern",
      "path": "/?frozen=1#e=7&t=2000",
      "note": "era 7 \u2014 the box; the network at its densest"
    },
    {
      "name": "shipwright",
      "path": "/?frozen=1#v=ship",
      "note": "hull.js shaders \u2014 HULL_VERT/FRAG, SAIL_VERT/FRAG"
    },
    {
      "name": "action",
      "path": "/?frozen=1#v=action",
      "note": "battle view"
    }
  ]
}
