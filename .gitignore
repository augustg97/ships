# large source datasets — never committed.
# ANCHORED with a leading slash: an unanchored `data/` also matches `web/data/`,
# which silently un-tracks the app's OWN data and ships a site that renders nothing.
/data/
*.tif
*.tiff
*.nc

# reference material used as a STANDARD: measured against, never reproduced
reference/

venv/
__pycache__/
.DS_Store
scratchpad/

# the tile pyramid is REGENERABLE: build_fields.py then build_tiles.py.
# docs/ carries the published copy; keeping the working copy out of git halves the repo.
/web/fields/

# frame-baseline scratch: `frames/` are the committed baselines, these are per-run
# working directories and would otherwise be swept in by any `git add -A`.
# _spin holds spin_capture.py surveys, _flap holds flap_test.py determinism probes.
/Research/baselines/_current/
/Research/baselines/_diff/
/Research/baselines/_spin/
/Research/baselines/_flap/

# firecrawl search caches, session-local
.firecrawl/

# per-run scratch under build/: candidate captures and bake intermediates are
# regenerable (bake-shore.py; the committed artefact is web/data/terrain/*.png),
# ratchet logs are recorded in HANDOFF + FRAME-LOG. inj-*.js ARE committed — they
# are the proof a rule can fire.
/build/staging/*.png
/build/staging/tiles/
/build/ratchet-*.log
/build/staging/*.log

# per-round frame snapshots for before/after measures — read locally, never committed
build/*-frames/

# the improvement-round mutex: a DIRECTORY, because mkdir is atomic. Committing it makes
# every fresh checkout look permanently locked — `git add -A` while holding it did exactly
# that in r125.
build/.loop.lock/

# in-copyright sources fetched whole for judgment reads (r178): kept local, never committed
build/staging/*/agius-*.pdf
build/staging/*/agius-*.txt
build/staging/*/flecker-*.pdf
build/staging/*/flecker-*.txt
build/staging/*/catnaps-*.html
build/staging/*/vosmer-*.pdf
build/staging/*/vosmer-*.txt
build/staging/*/ag-*.png
build/staging/*/fig-*.png
build/staging/*/hi-*.png
