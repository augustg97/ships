# large source datasets — never committed.
# ANCHORED with a leading slash: an unanchored `data/` also matches `web/data/`,
# which silently un-tracks the app's OWN data and ships a site that renders nothing.
/data/
*.tif
*.tiff
*.nc

# reference material used as a STANDARD: measured against, never reproduced
reference/

venv/
__pycache__/
.DS_Store
scratchpad/

# the tile pyramid is REGENERABLE: build_fields.py then build_tiles.py.
# docs/ carries the published copy; keeping the working copy out of git halves the repo.
/web/fields/

# frame-baseline scratch: `frames/` are the committed baselines, these are per-run
# working directories and would otherwise be swept in by any `git add -A`.
# _spin holds spin_capture.py surveys, _flap holds flap_test.py determinism probes.
/Research/baselines/_current/
/Research/baselines/_diff/
/Research/baselines/_spin/
/Research/baselines/_flap/

# firecrawl search caches, session-local
.firecrawl/
